        function addToCart(productId) {
          flyToCart(productId);
          const product = products.find(p => p.id === productId);
          if (!product) return;
          const card = document.querySelector(`[data-product-id="${productId}"]`);
          let selectedQty = 1;
          if (card) {
            const activeBtn = card.querySelector('.qty-btn.active');
            if (activeBtn) selectedQty = parseInt(activeBtn.dataset.lt);
          }
          const key = `${productId}_${selectedQty}`;
          if (cart[key]) cart[key].qty += 1;
          else cart[key] = {
            product,
            qty: 1,
            selectedQty
          };
          localStorage.setItem('sc_cart_home', JSON.stringify(cart));
          setTimeout(() => {
            updateCartUI();
          }, 2200);
          showAddedFeedback(productId);
        }

        function updateCartUI() {
          const keys = Object.keys(cart);
          const totalItems = keys.reduce((s, k) => s + cart[k].qty, 0);
          const badge = document.getElementById('cartBadge');
          const footer = document.getElementById('cartFooter');
          const list = document.getElementById('cartItemsList');
          badge.style.display = totalItems > 0 ? 'flex' : 'none';
          badge.textContent = totalItems;
          if (keys.length === 0) {
            list.innerHTML = `<div class="cart-empty-msg"><i class="fas fa-shopping-cart text-3xl mb-3 block opacity-30"></i>Your cart is empty</div>`;
            footer.style.display = 'none';
            return;
          }
          footer.style.display = 'block';
          let grandTotal = 0,
            itemsHTML = '';
          keys.forEach(key => {
            const {
              product,
              qty,
              selectedQty
            } = cart[key];
            const totalQty = selectedQty * qty;
            const lineTotal = product.price * totalQty;
            grandTotal += lineTotal;
            const qLabel = (product.hasLtOptions && !product.qtyOptions) ?
              ' Lt' :
              (product.qtyOptions ?
                (product.qtyLabel || ' pcs') :
                ' pcs');
            itemsHTML += `<div class="cart-item-row"><div style="flex:1"><p style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${product.name}</p>
              
             <p style="font-size:11px;color:#64748b;">${totalQty}${qLabel} × ₹${product.price}/${qLabel.trim()} </p>
              
              </div><div class="cart-item-qty-ctrl"><button class="cart-qty-btn" onclick="changeCartQty('${key}',-1)">−</button><span style="min-width:40px;text-align:center;font-size:12px;">${totalQty}${qLabel}</span><button class="cart-qty-btn" onclick="changeCartQty('${key}',1)">+</button></div><div style="display:flex;align-items:center;gap:8px;"><span style="font-weight:700;color:#1d4ed8;">₹${lineTotal}</span><button onclick="removeFromCart('${key}')" style="background:#fee2e2;border-radius:50%;width:20px;height:20px;color:#ef4444;">✕</button></div></div>`;
          });
          list.innerHTML = itemsHTML;
          document.getElementById('cartSubtotal').innerHTML = `₹${grandTotal}`;
          document.getElementById('cartTotal').innerHTML = `₹${grandTotal}`;
          const safeAmount = Math.round(grandTotal);
          const note = Object.values(cart).map(({
            product,
            qty,
            selectedQty
          }) => {
            const totalQty = selectedQty * qty;
            const label = (product.hasLtOptions && !product.qtyOptions) ? 'Lt' : (product.qtyOptions ? product.qtyLabel.trim() : '');
            return `${product.name} ${totalQty}${label}`;
          }).join(', ').replace(/[^a-zA-Z0-9 ]/g, '').substring(0, 50);
          const upiLink = `upi://pay?pa=boism-9352470085@boi&pn=Swapnil%20Chemicals&am=${safeAmount}&cu=INR&tn=${encodeURIComponent(note)}`;
          const gpayBtn = document.getElementById('cartGpayBtn');
          gpayBtn.innerHTML = `
      <i class="fab fa-whatsapp"></i>
      Enquiry ₹${safeAmount}
  `;
        }

        function changeCartQty(key, delta) {
          if (!cart[key]) return;
          const newQty = cart[key].qty + delta;
          if (newQty < 1) return;
          cart[key].qty = newQty;
          localStorage.setItem('sc_cart_home', JSON.stringify(cart));
          updateCartUI();
        }

        function removeFromCart(key) {
          delete cart[key];
          localStorage.setItem('sc_cart_home', JSON.stringify(cart));
          updateCartUI();
        }

        function clearCart() {
          cart = {};
          localStorage.removeItem('sc_cart_home');
          updateCartUI();
          document.getElementById('cartPanel').classList.add('hidden'); // custom 07-05-26
        }

        function toggleCart() {
          document.getElementById('cartPanel').classList.toggle('hidden');
        }

        function flyToCart(productId) {
          const card = document.querySelector(`[data-product-id="${productId}"]`);
          const cartBtn = document.querySelector('.cart-icon-btn');
          if (!card || !cartBtn) return;
          const cardRect = card.getBoundingClientRect();
          const cartRect = cartBtn.getBoundingClientRect();
          const flyEl = document.createElement('div');
          flyEl.className = 'fly-item';
          flyEl.innerHTML = '<i class="fas fa-box"></i>';
          flyEl.style.left = (cardRect.left + cardRect.width / 2 - 40) + 'px';
          flyEl.style.top = (cardRect.top + cardRect.height / 2 - 40) + 'px';
          document.body.appendChild(flyEl);
          const targetX = cartRect.left + cartRect.width / 2 - 25;
          const targetY = cartRect.top + cartRect.height / 2 - 25;
          requestAnimationFrame(() => {
            flyEl.style.transition = 'all 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            flyEl.style.left = targetX + 'px';
            flyEl.style.top = targetY + 'px';
            flyEl.style.transform = 'scale(0.3)';
            flyEl.style.opacity = '0';
          });
          setTimeout(() => {
            flyEl.remove();
            // Cart badge bounce
            const badge = document.querySelector('.cart-badge');
            if (badge) {
              badge.style.transform = 'scale(1.8)';
              setTimeout(() => badge.style.transform = 'scale(1)', 300);
            }
          }, 2200);
        }

        function openCartEnquiry() {
          let productsHtml = "";
          let totalAmount = 0;
          Object.keys(cart).forEach(key => {
            const item = cart[key];
            const product = item.product;
            const qty = item.selectedQty * item.qty;
            const label = product.hasLtOptions && !product.qtyOptions ?
              "Lt" :
              (product.qtyLabel || "pcs");
            const lineTotal = product.price * qty;
            totalAmount += lineTotal;
            productsHtml += `
          
          <div class="enquiry-product-preview">

              <img src="${product.image}">

              <div>
                  <p class="text-xs font-bold text-sky-700">
                      Selected Product
                  </p>

                  <p class="font-bold text-gray-800">
                      ${product.name}
                  </p>

                  <p class="text-sm font-semibold text-blue-600 mt-1">
                  ${qty} ${label} × ₹${product.price}/${label.trim()}
                 </p>
              </div>

          </div>
          
          `;
          });
          document.querySelector(".enquiry-body").innerHTML = `

          ${productsHtml}

          <div class="enquiry-field-wrap">

              <label class="text-xs font-bold text-gray-600 uppercase">
                  Workshop Name & Address
              </label>

              <textarea
                  id="cart-enquiry-details"
                  class="enquiry-textarea"
                  rows="2"
                  placeholder="Any specific requirements..."
              ></textarea>

          </div>

          <div class="enquiry-field-wrap">

              <label class="text-xs font-bold text-gray-600 uppercase">
                  Your Phone Number *
              </label>

              <input
                  type="tel"
                  id="cart-enquiry-phone"
                  class="enquiry-input"
                  maxlength="10"
                  placeholder="9876543210"
              >

          </div>

          <button class="enquiry-submit-btn" onclick="submitCartEnquiry()">

              <i class="fab fa-whatsapp"></i>

              Send Enquiry via WhatsApp

          </button>

          <p class="text-center text-xs text-gray-400 mt-3">
              Your enquiry will be sent directly to <b>Swapnil Chemicals</b> on WhatsApp
          </p>
      `;
          document.getElementById('enquiryModal').classList.add('show');
          document.body.style.overflow = 'hidden';
        }

        function submitCartEnquiry() {
          const phone =
            document.getElementById('cart-enquiry-phone').value.trim();
          if (!/^[6-9]\d{9}$/.test(phone)) {
            alert("Enter valid phone number");
            return;
          }
          const details =
            document.getElementById('cart-enquiry-details').value.trim();
          let msg =
            `🛒 *Cart Enquiry — Swapnil Chemicals*%0A%0A`;
