              qtyOpts.map((qty, i) => `<button class="qty-btn ${i===0?'active':''}" data-lt="${qty}" data-price="${product.price}" data-product="${encodeURIComponent(product.name)}" data-qty-label="${qtyLabel}" onclick="selectQty(this)">${qty} ${qtyLabel}</button>`).join('') +
              `</div></div>`;
          } else {
            qtyBtnsHtml = '';
          }
          return `<div class="product-card rounded-2xl overflow-hidden group ${hasLt ? '' : 'no-qty'}" data-product-id="${product.id}"><div class="product-image-container"><img src="${product.image}" alt="${product.name}" class="product-image" onerror="this.style.display='none'; this.nextElementSibling.style.opacity='1';"><div class="product-image-fallback"><i class="fas fa-image text-4xl mb-2"></i><p>Image not available</p></div></div><div class="p-6"><h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-blue-600">${product.name}</h3><p class="text-gray-600 mb-4">${product.description}</p><div class="flex justify-between items-center"><div class="text-2xl font-bold gradient-text">₹${product.price}<span class="text-lg text-gray-500 ml-1">/${product.unit}</span></div><div class="flex space-x-2"><a href="tel:9352470085" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm"><i class="fas fa-phone"></i></a><button class="enquiry-trigger-btn" onclick='openEnquiryModal(${JSON.stringify(product)})'><i class="fas fa-clipboard-list"></i> Enquiry</button></div></div>${qtyBtnsHtml}<button class="add-to-cart-btn" data-add-cart="${product.id}" onclick="addToCart(${product.id})"><i class="fas fa-shopping-cart"></i> Add to Cart</button></div></div>`;
        }

        function selectQty(btn) {
          const card = btn.closest('.product-card');
          card.querySelectorAll('.qty-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        }

        function renderProducts() {
          const container = document.getElementById('productsGrid');
          if (container) container.innerHTML = products.map(p => createProductCard(p)).join('');
        }
        let currentEnquiryProduct = null;

        function openEnquiryModal(product) {
          currentEnquiryProduct = product;
          document.getElementById('enquiry-product-name').innerText = product.name;
          document.getElementById('enquiry-product-img').src = product.image;
          document.getElementById('enquiry-product-rate').innerText = `₹${product.price} / ${product.unit}`;
          const qtyOpts = product.qtyOptions || (product.hasLtOptions ? LT_OPTIONS : []);
          const qtyLabel = product.qtyLabel || (product.hasLtOptions ? 'Lt' : 'pcs');
          const container = document.getElementById('enquiry-qty-buttons');
          container.innerHTML = '';
          if (qtyOpts.length) {
            qtyOpts.forEach((q, i) => {
              const btn = document.createElement('button');
              btn.className = `enquiry-qty-btn ${i===0?'active':''}`;
              btn.innerText = `${q} ${qtyLabel}`;
              btn.dataset.val = `${q} ${qtyLabel}`;
              btn.onclick = function() {
                container.querySelectorAll('.enquiry-qty-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('enquiry-qty-value').value = this.dataset.val;
              };
              container.appendChild(btn);
              if (i === 0) document.getElementById('enquiry-qty-value').value = btn.dataset.val;
            });
          } else {
            container.innerHTML = '<span class="text-sm text-gray-500">1 piece</span>';
            document.getElementById('enquiry-qty-value').value = '1 piece';
          }
          document.getElementById('enquiry-details').value = '';
          document.getElementById('enquiry-phone').value = '';
          document.getElementById('phone-error').style.display = 'none';
          document.getElementById('enquiryModal').classList.add('show');
          document.body.style.overflow = 'hidden';
        }

        function closeEnquiryModal() {
          document.getElementById('enquiryModal').classList.remove('show');
          document.body.style.overflow = '';
        }

        function submitEnquiry() {
          const phone = document.getElementById('enquiry-phone').value.trim();
          if (!/^[6-9]\d{9}$/.test(phone)) {
            document.getElementById('phone-error').style.display = 'block';
            return;
          }
          document.getElementById('phone-error').style.display = 'none';
          const qty = document.getElementById('enquiry-qty-value').value;
          const details = document.getElementById('enquiry-details').value.trim();
          const product = currentEnquiryProduct;
          const msg = `🛒 *Enquiry — Swapnil Chemicals*%0A📦 *Product:* ${product.name}%0A📏 *Qty:* ${qty}%0A📱 *Phone:* +91 ${phone}${details ? `%0A📝 *Details:* ${details}` : ''}%0A_Sent from website_`;
          window.open(`https://wa.me/919352470085?text=${msg}`, '_blank');
          closeEnquiryModal();
        }
        document.getElementById('enquiryModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('enquiryModal')) closeEnquiryModal();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeEnquiryModal();
        });

        function initContactForm() {
          const form = document.getElementById('contactForm');
          if (form) form.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('name').value,
              email = document.getElementById('email').value,
              msg = document.getElementById('message').value;
            window.open(`https://wa.me/919352470085?text=${encodeURIComponent(`Hi Swapnil Chemicals\nName: ${name}\nEmail: ${email}\nMessage: ${msg}`)}`, '_blank');
            form.reset();
            alert("Redirecting to WhatsApp...");
          });
        }

        function initScrollToTop() {
          const btn = document.getElementById('scrollToTop');
          window.addEventListener('scroll', () => btn.classList.toggle('hidden', window.scrollY <= 300));
          btn.addEventListener('click', () => window.scrollTo({
            top: 0,
            behavior: 'smooth'
          }));
        }

        function initSmoothScrolling() {
          document.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', function(e) {
            e.preventDefault();
            const t = document.querySelector(this.getAttribute('href'));
            if (t) t.scrollIntoView({
              behavior: 'smooth'
            });
          }));
        }

        function initScrollAnimations() {
          const obs = new IntersectionObserver((e) => e.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0)';
            }
          }), {
            threshold: 0.1
          });
          document.querySelectorAll('.product-card, .feature-card').forEach(c => {
            c.style.opacity = '0';
            c.style.transform = 'translateY(30px)';
            c.style.transition = '0.6s';
            obs.observe(c);
          });
        }
        document.addEventListener('DOMContentLoaded', () => {
          renderProducts();
          initScrollToTop();
          initContactForm();
          initSmoothScrolling();
          setTimeout(initScrollAnimations, 100);
          const saved = localStorage.getItem('sc_cart_home');
          if (saved) try {
            cart = JSON.parse(saved);
            updateCartUI();
          } catch (e) {
            cart = {};
          }
        });
        document.addEventListener('error', (e) => {
          if (e.target.tagName === 'IMG' && e.target.classList.contains('product-image')) {
            e.target.style.display = 'none';
            const fb = e.target.nextElementSibling;
            if (fb && fb.classList.contains('product-image-fallback')) fb.style.opacity = '1';
          }
        }, true);
      </script>
    </body>

  </html>
