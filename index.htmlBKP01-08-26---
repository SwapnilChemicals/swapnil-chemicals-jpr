              "Lt" :
              (product.qtyLabel || "pcs");
            const lineTotal = product.price * qty;
            grandTotal += lineTotal;
            msg += `📦 ${product.name} - Qty: ${qty} ${label}, Price: ₹${product.price} = Total: ₹${lineTotal}%0A`;
          });
          msg += `%0A📝 Details: ${details}`;
          msg += `%0A📱 Phone: ${phone}`;
          msg += `%0A💰 Grand Total: ₹${grandTotal}`;
          window.open(
            `https://wa.me/919352470085?text=${msg}`,
            '_blank'
